<Window x:Class="ProvisionTool.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings · Provision Tool"
        Width="600" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource FontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceHighBrush}" Padding="24,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="Deployment Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="24,20" Spacing="20">
                <!-- SSH Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="SSH Configuration" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Primary Username" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBox Text="{Binding Settings.PrimaryUsername}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Primary Password" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                        <PasswordBox x:Name="PrimaryPasswordBox" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Backup Username" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBox Text="{Binding Settings.BackupUsername}" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Backup Password" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                        <PasswordBox x:Name="BackupPasswordBox" />
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderBrush}" />

                <!-- Connection Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="8" Margin="0,0,12,0">
                            <TextBlock Text="Max Parallel" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBox Text="{Binding Settings.MaxParallelConnections}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="8">
                            <TextBlock Text="Connection Timeout (s)" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBox Text="{Binding Settings.ConnectionTimeoutSeconds}" />
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="8" Margin="0,12,12,0">
                            <TextBlock Text="Retries" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBox Text="{Binding Settings.ConnectionRetries}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="8" Margin="0,12,0,0">
                            <TextBlock Text="Reboot Timeout (s)" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                            <TextBox Text="{Binding Settings.RebootTimeoutSeconds}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderBrush}" />

                <!-- Deployment Settings -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Deployment Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Script URL" FontSize="11" Foreground="{StaticResource TextFaintBrush}" />
                        <TextBox Text="{Binding Settings.ScriptUrl}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
                    </StackPanel>

                    <CheckBox Content="Wait for Device Reboot" IsChecked="{Binding Settings.WaitForReboot}" Foreground="{StaticResource TextBrush}" />
                    <CheckBox Content="Auto Verify After Deploy" IsChecked="{Binding Settings.AutoVerifyAfterDeploy}" Foreground="{StaticResource TextBrush}" />
                    <CheckBox Content="Use SSH Key" IsChecked="{Binding Settings.UseSshKey}" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceHighBrush}" Padding="24,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Padding="20,10" Click="CancelButton_Click" />
                <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
