<UserControl x:Class="ProvisionTool.Views.DeviceLogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceHighBrush}" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Device Logs" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding CurrentDevice.Hostname}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="📋 Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Content="✕" Style="{StaticResource SecondaryButtonStyle}" Padding="8,8" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log Content -->
        <TextBox Grid.Row="1" 
                 Text="{Binding LogContent, Mode=OneWay}" 
                 Background="{StaticResource SurfaceBrush}" 
                 Foreground="{StaticResource TextBrush}"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="16"
                 TextWrapping="Wrap" />

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceHighBrush}" Padding="16,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="Status:" Foreground="{StaticResource TextFaintBrush}" FontSize="11" />
                <TextBlock Text="{Binding CurrentDevice.StatusMessage}" Foreground="{StaticResource TextBrush}" FontSize="11" />
                <TextBlock Text="Duration:" Foreground="{StaticResource TextFaintBrush}" FontSize="11" Margin="24,0,0,0" />
                <TextBlock Text="{Binding CurrentDevice.DeployDuration}" Foreground="{StaticResource TextBrush}" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
