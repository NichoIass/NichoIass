<Window x:Class="ProvisionTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provision Tool · Enterprise SSH Deployment v15.0"
        Width="1920" Height="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource FontFamily}"
        Icon="/Resources/icon.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Deploy System" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Multi-server SSH provisioning utility" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Stats -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Margin="0,0,32,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="OK" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SuccessfulDevices}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,32,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="FAIL" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FailedDevices}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,32,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource InfoBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="ACTIVE" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding ActiveDeployments}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource TextDimBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="TOTAL" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding TotalDevices}" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Bar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" Padding="28,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical" Spacing="12">
                <!-- Row 1: Credentials -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel Orientation="Vertical" Width="320">
                        <TextBlock Text="Primary SSH Credentials" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="150" Text="{Binding Settings.PrimaryUsername}" Placeholder="Username" />
                            <PasswordBox x:Name="PrimaryPasswordBox" Width="150" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="320">
                        <TextBlock Text="Backup SSH Credentials" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="150" Text="{Binding Settings.BackupUsername}" Placeholder="Username" />
                            <PasswordBox x:Name="BackupPasswordBox" Width="150" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="380">
                        <TextBlock Text="Script URL" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.ScriptUrl}" Placeholder="http://..." />
                    </StackPanel>
                </StackPanel>

                <!-- Row 2: Parameters -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel Orientation="Vertical" Width="200">
                        <TextBlock Text="Max Parallel" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.MaxParallelConnections}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="200">
                        <TextBlock Text="Retries" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.ConnectionRetries}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="200">
                        <TextBlock Text="Timeout (s)" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.ConnectionTimeoutSeconds}" />
                    </StackPanel>

                    <CheckBox Content="Wait for Reboot" IsChecked="{Binding Settings.WaitForReboot}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                    <CheckBox Content="Auto Verify" IsChecked="{Binding Settings.AutoVerifyAfterDeploy}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search and Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" Padding="28,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search by IP, hostname, user..." FontSize="13" />

                <!-- Autofill Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Autofill:" FontSize="12" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                    <Button Command="{Binding AutofillSshIpCommand}" Content="SSH IP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Command="{Binding AutofillTargetIpCommand}" Content="Target IP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Command="{Binding AutofillHostnameCommand}" Content="Hostname" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Command="{Binding StartAllCommand}" Content="▶ Start All" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsDeploying, Converter={StaticResource InvertBoolConverter}}" Padding="16,10" FontSize="13" />
                    <Button Command="{Binding StartSelectedCommand}" Content="▶ Start Selected" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsDeploying, Converter={StaticResource InvertBoolConverter}}" Padding="16,10" FontSize="13" />
                    <Button Command="{Binding StopAllCommand}" Content="■ Stop" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding IsDeploying}" Padding="16,10" FontSize="13" />
                    <Button Command="{Binding SaveSessionCommand}" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" FontSize="13" />
                    <Button Command="{Binding ExportReportCommand}" Content="📊 Export" Style="{StaticResource SecondaryButtonStyle}" Padding="16,10" FontSize="13" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Devices Table -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected}" Width="50" />
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True" />
                <DataGridTextColumn Header="SSH IP" Binding="{Binding SshIp}" Width="180" />
                <DataGridTextColumn Header="Target IP" Binding="{Binding TargetIp}" Width="180" />
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="160" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" />
                <DataGridTextColumn Header="Use Sudo" Binding="{Binding UseSudo}" Width="80" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusMessage}" Width="250" />
                <DataGridTextColumn Header="Duration" Binding="{Binding DeployDuration}" Width="100" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" Padding="28,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="Ready" Foreground="{StaticResource TextFaintBrush}" FontSize="11" />
        </Border>
    </Grid>
</Window>
