<Window x:Class="ProvisionTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProvisionTool.Utils"
        Title="Provision Tool · Enterprise SSH Deployment v15.0"
        Width="1920" Height="1200"
        MinWidth="1400" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource FontFamily}"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="InvertBoolConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with Stats -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,24,32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Deploy System" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="Multi-server SSH provisioning utility" FontSize="13" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Statistics Pills -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="28">
                    <Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource SuccessBrush}" />
                            <TextBlock Text="OK" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SuccessfulDevices}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" MinWidth="30" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource DangerBrush}" />
                            <TextBlock Text="FAIL" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding FailedDevices}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" MinWidth="30" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource InfoBrush}" />
                            <TextBlock Text="ACTIVE" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveDeployments}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" MinWidth="30" />
                        </StackPanel>
                    </Border>

                    <Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Ellipse Width="14" Height="14" Fill="{StaticResource TextDimBrush}" />
                            <TextBlock Text="TOTAL" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalDevices}" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="Bold" MinWidth="30" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Bar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" Padding="32,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Vertical" Spacing="16">
                <!-- Row 1: SSH Credentials -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <StackPanel Orientation="Vertical" Width="280">
                        <TextBlock Text="Primary SSH Credentials" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.PrimaryUsername}" Placeholder="Username" FontSize="12" Height="32" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="280">
                        <TextBlock Text="Backup SSH Credentials" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.BackupUsername}" Placeholder="Backup Username" FontSize="12" Height="32" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="400">
                        <TextBlock Text="Script URL" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.ScriptUrl}" Placeholder="http://10.50.12.11/deploy.sh" FontSize="12" Height="32" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="120">
                        <TextBlock Text="Max Parallel" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.MaxParallelConnections}" FontSize="12" Height="32" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Width="100">
                        <TextBlock Text="Retries" FontSize="11" Foreground="{StaticResource TextFaintBrush}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox Text="{Binding Settings.ConnectionRetries}" FontSize="12" Height="32" TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Row 2: Options -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox Content="Wait for Reboot" IsChecked="{Binding Settings.WaitForReboot}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="12" />
                    <CheckBox Content="Auto Verify" IsChecked="{Binding Settings.AutoVerifyAfterDeploy}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="12" />
                    <CheckBox Content="Use SSH Key" IsChecked="{Binding Settings.UseSshKey}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Search and Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundBrush}" Padding="32,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Placeholder="Search by IP, hostname, user..." FontSize="12" Height="36" />

                <!-- Autofill Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Autofill:" FontSize="12" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Command="{Binding AutofillSshIpCommand}" Content="SSH IP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Command="{Binding AutofillTargetIpCommand}" Content="Target IP" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                    <Button Command="{Binding AutofillHostnameCommand}" Content="Hostname" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" FontSize="12" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Command="{Binding StartAllCommand}" Content="▶ Start All" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding IsDeploying, Converter={StaticResource InvertBoolConverter}}" Padding="16,10" FontSize="12" FontWeight="SemiBold" />
                    <Button Command="{Binding StartSelectedCommand}" Content="▶ Selected" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding IsDeploying, Converter={StaticResource InvertBoolConverter}}" Padding="14,10" FontSize="12" />
                    <Button Command="{Binding StopAllCommand}" Content="■ Stop" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding IsDeploying}" Padding="14,10" FontSize="12" />
                    <Separator Width="1" Background="{StaticResource BorderBrush}" Margin="4,0" />
                    <Button Command="{Binding ImportCsvCommand}" Content="📥 Import" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" FontSize="12" />
                    <Button Command="{Binding ExportCsvCommand}" Content="📤 Export" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" FontSize="12" />
                    <Button Command="{Binding SaveSessionCommand}" Content="💾 Save" Style="{StaticResource SecondaryButtonStyle}" Padding="12,10" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Devices DataGrid -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding FilteredDevices}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False" 
                  CanUserSortColumns="True"
                  CanUserReorderColumns="False"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  RowHeight="44"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="44" />
                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True" />
                <DataGridTextColumn Header="SSH IP" Binding="{Binding SshIp}" Width="140" />
                <DataGridTextColumn Header="Target IP" Binding="{Binding TargetIp}" Width="140" />
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="140" />
                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="100" />
                <DataGridCheckBoxColumn Header="Sudo" Binding="{Binding UseSudo}" Width="60" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusMessage}" Width="280" IsReadOnly="True" />
                <DataGridTextColumn Header="Duration" Binding="{Binding DeployDuration}" Width="90" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceHighBrush}" Padding="32,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" />
                <TextBlock Text="Ready" Foreground="{StaticResource TextFaintBrush}" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
