<Application x:Class="ProvisionTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Colors -->
            <Color x:Key="BackgroundColor">#0C0D0F</Color>
            <Color x:Key="SurfaceColor">#151619</Color>
            <Color x:Key="SurfaceHighColor">#1B1C20</Color>
            <Color x:Key="BorderColor">#242529</Color>
            <Color x:Key="TextColor">#E6E6E8</Color>
            <Color x:Key="TextDimColor">#8A8C92</Color>
            <Color x:Key="TextFaintColor">#4C4D52</Color>
            <Color x:Key="AccentColor">#6C8CFF</Color>
            <Color x:Key="AccentHoverColor">#5A78E0</Color>
            <Color x:Key="SuccessColor">#48D597</Color>
            <Color x:Key="WarningColor">#F0B054</Color>
            <Color x:Key="DangerColor">#F1667C</Color>
            <Color x:Key="InfoColor">#57C4E8</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceHighBrush" Color="{StaticResource SurfaceHighColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
            <SolidColorBrush x:Key="TextFaintBrush" Color="{StaticResource TextFaintColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

            <!-- Fonts -->
            <FontFamily x:Key="FontFamily">Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

            <!-- Merge Theme Resources -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
